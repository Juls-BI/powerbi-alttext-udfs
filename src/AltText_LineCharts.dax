/* ============================================================================
   AltText Line Chart UDFs and Required Measures
   Repository: https://github.com/Juls-BI/powerbi-alttext-udfs
   Author: Juliana Smith
   Purpose:
   This file contains reusable DAX UDFs and supporting measures for generating
   accessible, descriptive alt text for line charts in Power BI.

   Contents:
   - AltText_LineChart UDF
   - Required base measures list
   - Example final measure for calling the UDF

   Notes:
   - All UDFs in this repository follow the same documentation pattern.
   - Measures listed here must exist in the data model for the UDF to work.
   - This file is safe to copy into any Power BI model.
   ============================================================================
*/

/* ============================================================================
   AltText_LineChart UDF
   Purpose:
   Generates dynamic, descriptive alt text for line charts showing Revenue and Cost trends.
   Includes month over month (MoM) and year to date (YTD) insights, with contextual wording
   based on percentage changes and current vs previous month values.

   Key Features:
   - Automatically detects trend strength (strong, slight, stable)
   - Provides formatted numeric and percentage comparisons
   - Summarises YTD totals for Revenue and Cost
   - Designed for accessibility and executive level clarity

   Inputs:
   TrendPeriod (text)
   MeasuresText (text)
   CategoryText (text)
   FiltersText (text)
   UnitsText (text)

   Numeric Inputs (passed in from model measures):
   RevChange, CostChange
   RevCurrent, RevPrev
   CostCurrent, CostPrev
   RevYTD, CostYTD

   Outputs:
   Structured alt text combining trend, measure, filter, and insight clauses
   ============================================================================
*/

DEFINE

FUNCTION AltText_LineChart =
(
    TrendPeriod: STRING,
    MeasuresText: STRING,
    CategoryText: STRING,
    FiltersText: STRING,
    UnitsText: STRING,

    RevChange: NUMERIC,
    CostChange: NUMERIC,
    RevCurrent: NUMERIC,
    RevPrev: NUMERIC,
    CostCurrent: NUMERIC,
    CostPrev: NUMERIC,
    RevYTD: NUMERIC,
    CostYTD: NUMERIC
) =>

VAR RevTrendText =
    SWITCH(
        TRUE(),
        ISBLANK(RevChange), "Revenue trend unavailable",
        RevChange > 0.05, "Revenue is increasing strongly",
        RevChange > 0, "Revenue is increasing slightly",
        RevChange < -0.05, "Revenue is decreasing significantly",
        RevChange < 0, "Revenue is decreasing slightly",
        "Revenue is stable"
    )

VAR CostTrendText =
    SWITCH(
        TRUE(),
        ISBLANK(CostChange), "Cost trend unavailable",
        CostChange > 0.05, "Cost is increasing strongly",
        CostChange > 0, "Cost is increasing slightly",
        CostChange < -0.05, "Cost is decreasing significantly",
        CostChange < 0, "Cost is decreasing slightly",
        "Cost is stable"
    )

VAR CostInsight =
    CostTrendText & ". Current month cost is " &
    FORMAT(CostCurrent, "#,##0") & ", " &
    FORMAT(CostChange, "0.0%") & " " &
    IF(CostChange < 0, "lower", "higher") &
    " than the previous month (" &
    FORMAT(CostPrev, "#,##0") & "). "

VAR RevInsight =
    RevTrendText & ". Current month revenue is " &
    FORMAT(RevCurrent, "#,##0") & ", " &
    FORMAT(RevChange, "0.0%") & " " &
    IF(RevChange < 0, "lower", "higher") &
    " than the previous month (" &
    FORMAT(RevPrev, "#,##0") & "). "

VAR YTDInsight =
    "Year-to-date revenue is " & FORMAT(RevYTD, "#,##0") &
    " and year-to-date cost is " & FORMAT(CostYTD, "#,##0") & ". "

VAR TrendClause =
    IF(ISBLANK(TrendPeriod), "", "Trend over " & TrendPeriod & ". ")

VAR MeasuresClause =
    IF(ISBLANK(MeasuresText), "", "Measures shown: " & MeasuresText & ". ")

VAR CategoryClause =
    IF(ISBLANK(CategoryText), "", "Categories: " & CategoryText & ". ")

VAR FiltersClause =
    IF(ISBLANK(FiltersText), "", "Filters applied: " & FiltersText & ". ")

VAR UnitsClause =
    IF(ISBLANK(UnitsText), "", "Units: " & UnitsText & ". ")

RETURN
    TrendClause &
    MeasuresClause &
    CategoryClause &
    FiltersClause &
    CostInsight &
    RevInsight &
    YTDInsight &
    UnitsClause


/* ============================================================================
   REQUIRED MEASURES FOR AltText_LineChart

   The following measures must exist in your model and be passed into the UDF.

   1. Month‑over‑Month % Change (numeric)
      - One measure returning the % change in Revenue vs previous month
      - One measure returning the % change in Cost vs previous month

   2. Current Month Values (numeric)
      - Revenue for the latest reporting month
      - Cost for the latest reporting month

   3. Previous Month Values (numeric)
      - Revenue for the previous reporting month
      - Cost for the previous reporting month

   4. Year‑to‑Date Totals (numeric)
      - Revenue YTD
      - Cost YTD

   5. Text Inputs (text)
      - A text measure describing the trend period (e.g., “Jan–Dec 2024”)
      - A text measure describing applied filters (e.g., region, segment)

   Notes:
   - All numeric measures must return numbers (not formatted text)
   - Text measures must return plain text
   ============================================================================
*/

/* ============================================================================
   Measure to call UDF (generic example)
   This example shows the required parameters in order.
   Replace each placeholder measure with your own model measures.
   ============================================================================
*/

AltText_LineChart =
AltText_LineChart(
    /* Text parameters */
    [Trend Period Text],     -- e.g., "Jan–Dec 2024"
    [Measures Description],  -- e.g., "Revenue, Cost"
    [Category Description],  -- optional text or BLANK()
    [Filters Description],   -- e.g., region, segment
    [Units Text],            -- e.g., currency, "GBP"

    /* MoM % numeric inputs */
    [Revenue MoM % Change],
    [Cost MoM % Change],

    /* Current and previous month numeric inputs */
    [Revenue Current Month],
    [Revenue Previous Month],
    [Cost Current Month],
    [Cost Previous Month],

    /* YTD numeric inputs */
    [Revenue YTD],
    [Cost YTD]
)
